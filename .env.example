# --- Shopify (Partner Dashboard > Apps > Pickday > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_orders,read_draft_orders,write_draft_orders,read_products,write_products,write_publications,read_locations,read_themes,read_markets,write_validations,write_delivery_customizations
# Your Render URL, no trailing slash
SHOPIFY_APP_URL=https://pickday.onrender.com
# App handle from the Partner Dashboard URL (used for links in the digest email and embed detection)
SHOPIFY_APP_HANDLE=pickday

# --- Neon Postgres (Dashboard > Connection details)
# Pooled connection (host contains "-pooler"), used by the app:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
# Direct connection (no "-pooler"), used only for migrations:
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# --- Scheduled jobs (cron-job.org sends this in the X-Pickday-Secret header)
JOBS_SECRET=change-me-to-a-long-random-string

# --- Brevo (merchant daily digest). Leave empty to disable email.
BREVO_API_KEY=
EMAIL_FROM=digest@your-domain.com

# --- Branding / support
SUPPORT_EMAIL=support@your-domain.com

NODE_ENV=production

# --- Billing: "true" makes plan charges test charges (no money). Must be "false" in production for the App Store.
BILLING_TEST=false
