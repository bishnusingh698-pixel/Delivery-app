{
  "name": "pickday",
  "private": true,
  "scripts": {
    "build": "npm run build:widget && react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "npm run build:widget && shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node server.mjs",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p extensions/pickday-admin && tsc --noEmit -p extensions/pickday-thank-you && tsc --noEmit -p extensions/pickday-customer-change",
    "build:widget": "node scripts/build-widget.mjs",
    "test": "vitest run",
    "test:browser": "npm run build:widget && tsx tests/browser/widget.browser.ts && tsx tests/browser/preview.browser.ts",
    "test:watch": "vitest",
    "render-build": "npm ci --include=dev && npm run build && prisma generate",
    "render-start": "prisma migrate deploy && npm run start"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/express": "7.18.2",
    "@react-router/serve": "7.18.2",
    "compression": "1.8.2",
    "express": "4.22.3",
    "morgan": "1.12.1",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "date-holidays": "3.37.0",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "jsdom": "26.1.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "3.2.7"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0"
    }
  },
  "version": "0.1.0"
}
