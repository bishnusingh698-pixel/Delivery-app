{
  "include": ["env.d.ts", "app/**/*.ts", "app/**/*.tsx", "core/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "widget/**/*.ts", ".react-router/types/**/*", "vite.config.ts", "vitest.config.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "types": ["@react-router/node", "vite/client", "@shopify/polaris-types", "@shopify/app-bridge-types"],
    "rootDirs": [".", "./.react-router/types"]
  }
}
