{%- comment -%} Boot data for the Pickday widget. Everything comes from app-owned metafields, so the storefront never needs the Pickday server. {%- endcomment -%}
<script id="pickday-data" type="application/json">
{
  "config": {{ app.metafields.pickday.config.value | json | default: 'null' }},
  "availability": {{ app.metafields.pickday.availability.value | json | default: 'null' }},
  "cart": {
    "item_count": {{ cart.item_count | json }},
    "attributes": {{ cart.attributes | json }},
    "total_price": {{ cart.total_price | json }},
    "currency": {{ cart.currency.iso_code | json }},
    "items": [
      {%- for item in cart.items -%}
        {"key": {{ item.key | json }}, "id": {{ item.variant_id | json }}, "product_id": {{ item.product_id | json }}, "variant_id": {{ item.variant_id | json }}, "quantity": {{ item.quantity | json }}, "title": {{ item.title | json }}, "product_title": {{ item.product.title | json }}, "handle": {{ item.product.handle | json }}, "gift_card": {{ item.gift_card | json }}, "requires_shipping": {{ item.requires_shipping | json }}, "properties": {{ item.properties | json }}, "final_line_price": {{ item.final_line_price | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  },
  {%- liquid
    # The product of a product page: "Buy it now" there asks for the date first (Appearance setting).
    assign pd_needs_shipping = false
    if template.name == 'product' and product
      for v in product.variants
        if v.requires_shipping
          assign pd_needs_shipping = true
          break
        endif
      endfor
    endif
  -%}
  "product": {%- if template.name == 'product' and product -%}
    {"id": {{ product.id | append: '' | json }}, "title": {{ product.title | json }}, "tags": {{ product.tags | json }}, "collections": [{% for c in product.collections limit: 50 %}{{ c.id | append: '' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}], "giftCard": {{ product.gift_card? | json }}, "requiresShipping": {{ pd_needs_shipping | json }}, "variants": [{% for v in product.variants limit: 100 %}{"id": {{ v.id | append: '' | json }}, "requiresShipping": {{ v.requires_shipping | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
  {%- else -%}null{%- endif -%},
  "locale": {{ request.locale.iso_code | json }},
  "country": {{ localization.country.iso_code | json }},
  "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
  "rate": 1,
  "template": {{ template.name | append: '' | json }},
  "pseudo": {% if request.design_mode and block.settings.pseudo %}true{% else %}false{% endif %},
  "assetBase": {{ 'pickday.js' | asset_url | split: 'pickday.js' | first | json }},
  "itemCollections": {
    {%- for item in cart.items limit: 100 -%}
      {{ item.product_id | append: '' | json }}: [{% for c in item.product.collections limit: 50 %}{{ c.id | append: '' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  },
  "itemTags": {
    {%- for item in cart.items limit: 100 -%}
      {{ item.product_id | append: '' | json }}: {{ item.product.tags | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
}
</script>
